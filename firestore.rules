rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminEmails() {
      return ['vinayaklambodar6@gmail.com'];
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath());
    }

    function userRole() {
      return hasUserDoc() ? get(userPath()).data.role : '';
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email in adminEmails() || userRole() == 'admin'
      );
    }

    function isTeacher() {
      return signedIn() && userRole() == 'teacher';
    }

    // Staff directory: everyone can read their own role, admins can manage all.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && (
        isAdmin() || (
          request.auth.uid == uid && (
            (request.resource.data.role == 'admin' && request.auth.token.email in adminEmails()) ||
            (request.resource.data.role == 'pending' && request.resource.data.status == 'pending')
          )
        )
      );

      allow update, delete: if isAdmin();
    }

    // Audit trail: users may append their own login/signup events; only admins
    // can read the log. Entries can never be edited or deleted.
    match /accessLogs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Teachers can read portal data but only admins can change it.
    match /teachers/{docId} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    match /substitutions/{docId} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    match /dailyLogs/{docId} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    match /syllabus/{docId} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    // Defaulter records are admin-only.
    match /defaulters/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
